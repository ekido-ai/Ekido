[Unit]
Description=Ekido stack: coordinator, verifiers, CPU providers and a local test chain
After=network-online.target
Wants=network-online.target

[Service]
User=gpuchain
WorkingDirectory=/opt/GPUchain
EnvironmentFile=/etc/gpuchain/stack.env
ExecStart=/opt/GPUchain/.cache/cpu-venv/bin/python experiments/demo_stack.py --cpu --no-docker --total-steps 6000
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/GPUchain

[Install]
WantedBy=multi-user.target
