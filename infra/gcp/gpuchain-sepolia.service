[Unit]
Description=GPUChain Base Sepolia coordinator
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=true
User=gpuchain-sepolia
WorkingDirectory=/opt/gpuchain-sepolia
StateDirectory=gpuchain-sepolia
StateDirectoryMode=0700
Environment=PYTHONPATH=/opt/gpuchain-sepolia/apps/coordinator:/opt/gpuchain-sepolia/packages/gpuchain_core
Environment=DATABASE_URL=sqlite:////var/lib/gpuchain-sepolia/jobs.db
Environment=ARTIFACT_DIR=/var/lib/gpuchain-sepolia/artifacts
EnvironmentFile=/etc/gpuchain/sepolia.env
ExecStart=/opt/gpuchain-sepolia/venv/bin/python infra/gcp/sepolia_coordinator.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
