[Unit]
Description=Ekido checkpoint retention (moves checkpoint blobs no job needs any more to quarantine)
After=gpuchain-sepolia.service

[Service]
Type=oneshot
# Reads the coordinator's database and moves files inside its state folder, so it runs as root, not as the
# coordinator's dynamic user. Rules: apps/coordinator/ekido_coordinator/retention.py.
WorkingDirectory=/opt/gpuchain-sepolia
Environment=PYTHONPATH=/opt/gpuchain-sepolia/apps/coordinator:/opt/gpuchain-sepolia/packages/ekido_core
Environment=DATABASE_URL=sqlite:////var/lib/gpuchain-sepolia/jobs.db
Environment=ARTIFACT_DIR=/var/lib/gpuchain-sepolia/artifacts
# Dry run: it only logs what it would move. After a week of sensible logs, turn it on with a drop-in:
#   systemctl edit gpuchain-retention.service   ->   [Service] / ExecStart= / ExecStart=... -m ekido_coordinator.retention --apply
ExecStart=/opt/gpuchain-sepolia/venv/bin/python -m ekido_coordinator.retention
Nice=10
