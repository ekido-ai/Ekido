[Unit]
Description=Ekido Base Sepolia smoke provider (CPU, joins the hosted network)
After=network-online.target gpuchain-sepolia.service caddy.service
Wants=network-online.target

[Service]
# A throwaway system user created at start, like the original transient unit; its key and work folder live in
# /var/lib/private/gpuchain-sepolia-smoke (linked from /var/lib/gpuchain-sepolia-smoke).
DynamicUser=yes
StateDirectory=gpuchain-sepolia-smoke
WorkingDirectory=/opt/gpuchain-sepolia
Environment=PYTHONPATH=/opt/gpuchain-sepolia/workers/agent:/opt/gpuchain-sepolia/workers/runtime:/opt/gpuchain-sepolia/packages/ekido_core
ExecStart=/opt/gpuchain-sepolia/venv/bin/python -m ekido_agent.join --coordinator wss://gpuchain.duckdns.org/sepolia --name "Sepolia CPU verification" --price 0.001 --device cpu --workdir /var/lib/gpuchain-sepolia-smoke/work --key-file /var/lib/gpuchain-sepolia-smoke/provider.key
Restart=always
RestartSec=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
