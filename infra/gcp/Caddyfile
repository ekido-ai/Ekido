(secure) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Automatic HTTPS from Let's Encrypt. sslip.io maps the name to the VM's IP, so no domain purchase is needed.
__HOST__ {
	import secure
	encode gzip
	reverse_proxy 127.0.0.1:3100
}

api.__HOST__ {
	import secure
	# The existing dashboard is built against this API host. Permit the DuckDNS
	# dashboard origin while retaining the coordinator's normal write lock.
	@duckdns header Origin https://gpuchain.duckdns.org
	handle @duckdns {
		reverse_proxy 127.0.0.1:8000 {
			header_up Origin https://__HOST__
			header_down Access-Control-Allow-Origin https://gpuchain.duckdns.org
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

# Base Sepolia (see sepolia.Caddyfile): coordinator under /sepolia, its dashboard on 3101.
# ekido.duckdns.org is the main site. gpuchain.duckdns.org stays as the provider and API domain. Both serve the same app;
# the coordinator allows both origins through CORS_ORIGINS in /etc/gpuchain/sepolia.env.
gpuchain.duckdns.org, ekido.duckdns.org {
	import secure
	encode gzip
	# The commit the server is running, published by infra/gcp/ops/gpuchain-autodeploy.sh.
	handle_path /deploy/* {
		@version path /version.json
		handle @version {
			header Cache-Control "no-store"
			root * /var/lib/gpuchain-autodeploy/public
			file_server
		}
		respond 404
	}
	handle_path /sepolia/* {
		reverse_proxy 127.0.0.1:8003
	}
	handle {
		reverse_proxy 127.0.0.1:3101
	}
}
