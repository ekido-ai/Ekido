# Copy to .env. Never commit .env.
# Use testnet-only wallets. Never put a key that holds real funds here.

# Database
POSTGRES_USER=gpuchain
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gpuchain
DATABASE_URL=postgresql+psycopg://gpuchain:change-me-local-only@127.0.0.1:5433/gpuchain

# Demo fault injection endpoints. Keep at 0 unless running the demo.
DEMO_MODE=0

# Lets another machine use the operator API (jobs, faults). Empty means only this laptop can.
# Set a long random value before any hotspot session. Agents and verifiers don't need it.
API_TOKEN=

# Chain: Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
RPC_URL_FALLBACK=
EXPLORER_URL=https://sepolia.basescan.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ESCROW_ADDRESS=
REGISTRY_ADDRESS=

# Chain: local fallback. Set CHAIN_ID=31337 and RPC_URL=http://127.0.0.1:8545 to use Anvil.

# Testnet keys
DEPLOYER_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=
VERIFIER_1_PRIVATE_KEY=
VERIFIER_2_PRIVATE_KEY=
VERIFIER_3_PRIVATE_KEY=
ARBITER_PRIVATE_KEY=

# Deploying contracts (contracts/script/Deploy.s.sol) only needs DEPLOYER_PRIVATE_KEY on that machine.
# For the other roles you can give an address instead of a key; an address wins when both are set.
# COORDINATOR_ADDRESS=
# ARBITER_ADDRESS=
# VERIFIER_1_ADDRESS=
# VERIFIER_2_ADDRESS=
# VERIFIER_3_ADDRESS=
